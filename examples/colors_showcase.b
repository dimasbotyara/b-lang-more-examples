// ============================================
// Демонстрация цветов, стилей и спецэффектов
// ============================================

печать цвет.градиент "🌈 ЦВЕТА И СТИЛИ", "красный", "фиолетовый"
печать ""

// --- Простые цвета ---
печать "Красный" цвет красный
печать "Зелёный" цвет зелёный
печать "Синий" цвет синий
печать "Жёлтый" цвет жёлтый
печать "Бирюзовый" цвет бирюзовый
печать "Золотой" цвет золотой
печать "Янтарь" цвет янтарь
печать "Коралловый" цвет коралловый

печать ""

// --- Стили ---
печать "Жирный" жирный
печать "Курсив" курсив
печать "Подчёркнутый" подчёркнутый
печать "Тусклый" тусклый

печать ""

// --- Комбинации ---
печать "Ошибка" цвет коралловый жирный
печать "Предупреждение" цвет янтарь жирный
печать "Успех" цвет изумрудный жирный

печать ""

// --- Truecolor ---
печать "Свой HEX" цвет #FF00AA
печать "RGB-цвет" цвет rgb 100, 200, 50

печать ""

// --- Спецэффекты ---
печать цвет.радуга "Радуга!"
печать цвет.огонь "Огонь!"
печать цвет.градиент "Градиент", "голубой", "розовый"

печать ""
печать цвет.палитра
