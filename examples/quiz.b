печать цвет.градиент "=== ВИКТОРИНА ===", "фиолетовый", "розовый"
печать ""

пусть счёт число = 0

// --- Вопрос 1 ---
печать "1. Сколько будет 2 + 2?" цвет бирюзовый жирный
пусть ответ1 число = ввод "   Ответ: " или 0
если ответ1 равно 4
    печать "   ✅ Верно!" цвет зелёный
    счёт = счёт плюс 1
иначе
    печать "   ❌ Неверно. Правильный ответ: 4" цвет коралловый

печать ""

// --- Вопрос 2 ---
печать "2. Столица Франции?" цвет бирюзовый жирный
пусть ответ2 строка = ввод "   Ответ: " или ""
если ответ2 равно "Париж" или ответ2 равно "париж" или ответ2 равно "ПАРИЖ"
    печать "   ✅ Верно!" цвет зелёный
    счёт = счёт плюс 1
иначе
    печать "   ❌ Неверно. Правильный ответ: Париж" цвет коралловый

печать ""

// --- Вопрос 3 ---
печать "3. Сколько планет в Солнечной системе?" цвет бирюзовый жирный
пусть ответ3 число = ввод "   Ответ: " или 0
если ответ3 равно 8
    печать "   ✅ Верно!" цвет зелёный
    счёт = счёт плюс 1
иначе
    печать "   ❌ Неверно. Правильный ответ: 8" цвет коралловый

печать ""
печать "━━━━━━━━━━━━━━━━━━━━━━" цвет серый
печать "Твой счёт: {счёт} из 3" цвет золотой жирный

если счёт равно 3
    печать цвет.радуга "Идеально! 🏆"
иначе если счёт больше 0
    печать цвет.огонь "Неплохо! 🔥"
иначе
    печать "Попробуй ещё раз!" цвет янтарь
