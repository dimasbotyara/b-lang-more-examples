// ============================================
// Числа Фибоначчи
// ============================================
// 0, 1, 1, 2, 3, 5, 8, 13, 21, ...

печать цвет.радуга "Числа Фибоначчи:"
печать "---" цвет серый

пусть n число = 15
пусть a число = 0
пусть b число = 1
пусть i число = 0

пока i меньше n
    печать "  F({i}) = {a}" цвет золотой
    пусть следующий число = a плюс b
    a = b
    b = следующий
    i = i плюс 1
