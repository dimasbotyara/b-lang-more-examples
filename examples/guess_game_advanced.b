// ============================================
// 🎯 Угадай число — продвинутая версия
// ============================================
// Фичи:
//   • выбор сложности через вопрос.выбор (стрелками)
//   • подсказки «намного больше/меньше» через порог
//   • лимит попыток → проигрыш
//   • нельзя называть одно число дважды
//   • проверка диапазона

импорт рандом
импорт математика
импорт вопрос

печать цвет.градиент "🎯 УГАДАЙ ЧИСЛО", "бирюзовый", "золотой"
печать ""

// --- Выбор сложности ---
пусть уровень строка = вопрос.выбор "Выбери сложность:", ["лёгкая", "нормальная", "сложная"]

пусть максимум число = 100
пусть попыток_макс число = 15

если уровень равно "нормальная"
    максимум = 250
    попыток_макс = 12
иначе если уровень равно "сложная"
    максимум = 500
    попыток_макс = 8

печать ""
печать "Сложность: {уровень}" цвет бирюзовый жирный
печать "Диапазон:  1..{максимум}" цвет голубой
печать "Попыток:   {попыток_макс}" цвет голубой
печать ""

// --- Игра ---
пусть секрет число = рандом.число 1, максимум
пусть попытки число = 0
пусть угадал бул = ложь
пусть история список = []

пока не угадал
    // Проигрыш?
    если попытки больше_равно попыток_макс
        печать ""
        печать "💀 Ты проиграл!" цвет коралловый жирный
        печать "Было загадано: {секрет}" цвет янтарь
        прервать

    пусть осталось число = попыток_макс минус попытки
    пусть ответ число = ввод "Догадка (осталось {осталось}): " или 0

    // Проверка диапазона
    если ответ меньше 1 или ответ больше максимум
        печать "  ⚠ Введи число от 1 до {максимум}" цвет янтарь
        продолжить

    // Проверка повтора
    пусть уже_был бул = ложь
    для x в история
        если x равно ответ
            уже_был = истина

    если уже_был
        печать "  ⚠ Это число уже было! Попытка не засчитана" цвет янтарь
        продолжить

    попытки = попытки плюс 1
    история.добавить(ответ)

    // Победа?
    если ответ равно секрет
        печать ""
        печать "🎉 Угадал за {попытки} из {попыток_макс}!" цвет зелёный жирный
        угадал = истина
    иначе
        // Подсказка
        пусть разница число = ответ минус секрет
        пусть абс_разница число = математика.модуль разница
        пусть порог число = максимум делить 5

        если абс_разница больше порог
            если разница больше 0
                печать "  🔥 Намного МЕНЬШЕ" цвет коралловый жирный
            иначе
                печать "  🔥 Намного БОЛЬШЕ" цвет коралловый жирный
        иначе
            если разница больше 0
                печать "  ⬇ Меньше" цвет янтарь
            иначе
                печать "  ⬆ Больше" цвет янтарь
