// ============================================
// 🧮 КАЛЬКУЛЯТОР v2
// ============================================
// Возможности:
//   • меню операций стрелками (вопрос.выбор)
//   • история вычислений
//   • обработка ошибок (деление на 0, корень из отрицательного)
//   • факториал через цикл пока
//   • красивый вывод (градиент, радуга, цвета)

импорт математика
импорт вопрос

печать цвет.градиент "🧮 КАЛЬКУЛЯТОР v2", "бирюзовый", "золотой"
печать ""

пусть история список = []
пусть работаем бул = истина

пока работаем
    печать "━━━━━━━━━━━━━━━━━━━━━━" цвет серый
    пусть операция строка = вопрос.выбор "Операция:", ["сложение", "вычитание", "умножение", "деление", "степень", "корень", "модуль", "факториал", "показать историю", "выход"]

    если операция равно "выход"
        работаем = ложь

    иначе если операция равно "показать историю"
        если история.длина равно 0
            печать "  📭 История пуста" цвет серый
        иначе
            печать "  📜 История:" цвет бирюзовый жирный
            для запись в история
                печать "    {запись}" цвет серый

    иначе если операция равно "корень" или операция равно "модуль" или операция равно "факториал"
        пусть x число = ввод "Число: " или 0

        если операция равно "корень"
            если x меньше 0
                печать "  ❌ Корень из отрицательного нельзя" цвет коралловый
                продолжить
            пусть r число = математика.корень x
            печать "  = {r}" цвет золотой жирный
            история.добавить("√{x} = {r}")

        иначе если операция равно "модуль"
            пусть r число = математика.модуль x
            печать "  = {r}" цвет золотой жирный
            история.добавить("|{x}| = {r}")

        иначе
            если x меньше 0
                печать "  ❌ Факториал отрицательного нельзя" цвет коралловый
                продолжить
            если x больше 20
                печать "  ❌ Слишком большое (макс 20)" цвет коралловый
                продолжить
            пусть r число = 1
            пусть i число = 2
            пока i меньше_равно x
                r = r умножить i
                i = i плюс 1
            печать "  = {r}" цвет золотой жирный
            история.добавить("{x}! = {r}")

    иначе
        пусть a число = ввод "Первое число: " или 0
        пусть b число = ввод "Второе число: " или 0

        если операция равно "сложение"
            пусть r число = a плюс b
            печать "  = {r}" цвет золотой жирный
            история.добавить("{a} + {b} = {r}")

        иначе если операция равно "вычитание"
            пусть r число = a минус b
            печать "  = {r}" цвет золотой жирный
            история.добавить("{a} − {b} = {r}")

        иначе если операция равно "умножение"
            пусть r число = a умножить b
            печать "  = {r}" цвет золотой жирный
            история.добавить("{a} × {b} = {r}")

        иначе если операция равно "деление"
            если b равно 0
                печать "  ❌ Деление на ноль!" цвет коралловый
                продолжить
            пусть r число = a делить b
            печать "  = {r}" цвет золотой жирный
            история.добавить("{a} ÷ {b} = {r}")

        иначе если операция равно "степень"
            пусть r число = математика.степень a, b
            печать "  = {r}" цвет золотой жирный
            история.добавить("{a}^{b} = {r}")

печать ""
печать цвет.радуга "До встречи! 🐝"
