// ============================================
// Обратный отсчёт 🚀
// ============================================
импорт время

печать цвет.радуга "🚀 Обратный отсчёт"
печать "---" цвет серый

для i в 5..0 шаг -1
    если i равно 0
        печать "ПУСК! 🔥" цвет золотой жирный
    иначе
        печать "  {i}..." цвет янтарь жирный
        время.пауза 1
