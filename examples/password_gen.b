// ============================================
// Генератор паролей и токенов
// ============================================
импорт криптография

печать цвет.радуга "=== Генератор паролей ==="
печать ""

пусть длина число = ввод "Длина пароля (например 16): " или 16

печать ""
печать "🔐 Пароль:" цвет бирюзовый жирный
печать "   {криптография.пароль длина}" цвет изумрудный

печать ""
печать "🎫 Токен:" цвет бирюзовый жирный
печать "   {криптография.токен 32}" цвет золотой

пусть хеш строка = криптография.sha256 "b-lang"
печать "🔒 SHA-256 от 'b-lang':" цвет бирюзовый жирный
печать "   {хеш}" цвет серый

пусть б64 строка = криптография.base64 "привет"
печать "🎲 Base64 от 'привет':" цвет бирюзовый жирный
печать "   {б64}" цвет лиловый
