// ============================================
// Таблица умножения
// ============================================

печать цвет.градиент "Таблица умножения", "изумрудный", "золотой"
печать ""

пусть n число = 10

для i в 1..n
    пусть стр строка = "{i} |"
    для j в 1..n
        пусть p число = i умножить j
        стр = стр плюс " {p}"
    печать стр цвет бирюзовый
